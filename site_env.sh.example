# Copy to site_env.sh and put whatever THIS cluster needs
# before Python runs, e.g.:
#
#   module purge
#   module load anaconda3        # or miniforge / miniconda - whatever provides `conda`
#   module load cuda/12.4        # only if the cluster requires it for PyTorch wheels
#
# Keep large caches off the small home quota:
#   export PIP_CACHE_DIR=/path/to/scratch/pip_cache
#   export CONDA_PKGS_DIRS=/path/to/scratch/conda_pkgs
